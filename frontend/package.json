{
  "name": "dashforge-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "node scripts/start-lan-https.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.package-tools.json && vite build",
    "test": "vitest run",
    "package:meeting-dashboard": "vite build --ssr package-tools/materializeMeetingDashboardPackage.ts --outDir dist-package-tools && node dist-package-tools/materializeMeetingDashboardPackage.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "echarts": "^6.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^2.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
